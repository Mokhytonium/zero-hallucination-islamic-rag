# کلید OpenRouter — فقط برای لایه‌ی داوری مصرف می‌شود (امبدینگ و رتبه‌بند محلی‌اند).
# این فایل را به .env کپی کنید و کلید واقعی را جایگزین کنید. هرگز کامیت نکنید.
OPENROUTER_API_KEY=sk-or-v1-...

# --- داوری (اختیاری؛ پیش‌فرض‌ها کار می‌کنند) ---
# JUDGE_MODEL=google/gemini-2.5-flash-lite
# BUDGET_CAP_USD=0.50          # سقف سخت هزینه‌ی تجمعی API

# --- بازیابی (اختیاری) ---
# TOP_K=15                     # تعداد کاندید نهایی
# RETRIEVAL_POOL=150           # استخر فیوژن RRF
# MAX_CANDIDATES_PER_SOURCE=12 # تعداد کاندیدی که داور می‌بیند
# PRIMARY_TRANSLATION=fa.makarem

# --- بازرتبه‌بندی محلی (اختیاری) ---
# USE_RERANKER=true            # اگر وزن‌ها کامل نباشند خودکار به RRF برمی‌گردد
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_POOL=80               # پیش‌فرضِ حداکثر دقت (اندازه‌گیری کامل: یک بازیابی اضافه، صفر رگرسیون)؛ ۶۰ سریع‌تر (~۶۳s به‌جای ~۸۰s) ولی id38 را از دست می‌دهد؛ ۳۰ (~۴۱s) یک رگرسیون دیگر هم دارد
# RERANKER_BATCH_SIZE=16       # در هر دو اندازه‌گیری بهتر از ۳۲ بود (تفاوت کوچک، در بازه‌ی نویز)
# RERANKER_MAX_LENGTH=512      # سقف توکن جفتِ گزاره–قطعه؛ طول واقعی قطعه‌ها معمولاً بسیار کمتر است
#
# نکته: تغییر هر یک از این تنظیمات، کش پاسخ‌ها را ابطال می‌کند (کلید کش شامل امضای پیکربندی است).
# نکته: اگر داور در دسترس نباشد، جست‌وجو شکست نمی‌خورد؛ نتایج با برچسب Unverified و هشدار صریح برمی‌گردند.